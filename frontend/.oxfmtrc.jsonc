{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  // Generated from the OpenAPI contract; must stay byte-identical to the
  // generator output or the contract drift check fails.
  "ignorePatterns": ["src/api/types.gen.ts"],
}
