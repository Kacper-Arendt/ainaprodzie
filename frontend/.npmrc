# Node 20 cannot run this toolchain: jsdom 30 pulls undici 8, which needs Node 22+,
# and the failure surfaces as `webidl.util.markAsUncloneable is not a function` with
# zero tests run, which reads like a pass. Refuse to install on the wrong engine
# rather than let that happen. The required version lives in package.json `engines`
# and .nvmrc; this only makes it binding.
engine-strict=true
