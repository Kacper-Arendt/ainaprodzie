# Retrofit environment configuration.
# Copy to .env in the project root, next to compose.yaml, and adjust. .env is gitignored, never commit real credentials.

# The chat's model provider. Docker Compose reads these for the LiteLLM container
# (litellm/config.yaml); the app itself never sees them. Set at least one. A key
# exported in the shell wins over this file. Leave an unused key empty rather
# than a sample value, which LiteLLM would send to the provider as a real key.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic, for chat-anthropic on the settings page: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# PostgreSQL connection. Required: without a profile there are no defaults and
# the app refuses to start. The dev and test profiles fall back to these same
# values (and spring-boot-docker-compose overrides them with the compose.yaml
# container).
# The error does not name the variable: a missing DB_URL stops startup with
# 'url' must start with "jdbc", and a missing DB_USERNAME or DB_PASSWORD is sent
# as the literal ${...} text and shows up as a Postgres authentication error.
DB_URL=jdbc:postgresql://localhost:5432/retrofit
DB_USERNAME=retrofit
DB_PASSWORD=retrofit

# Active Spring profile. Leave it commented out: that is production behaviour.
# Uncommenting "dev" seeds the well-known local accounts (user@example.com and
# support@example.com, password "password") and exposes /v3/api-docs, so it must
# never reach a real instance.
#SPRING_PROFILES_ACTIVE=dev

# Never set SPRING_LIQUIBASE_CONTEXTS (or spring.liquibase.contexts) on a real
# instance. It replaces the "schema" context the app pins: "schema,dev" applies
# the dev seed and its well-known accounts, and an empty value runs every
# changeset, the dev seed included.

# HTTPS IS MANDATORY for anything that is not localhost. The session cookie is
# Secure unconditionally, so over plain http:// on any other host the browser
# discards it and nobody can log in: the login looks like it simply does nothing.
